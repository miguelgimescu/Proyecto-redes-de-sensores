@article{Ezzeldin2023,
   abstract = {Table Tennis is a renowned competitive and recreational sport. An Olympic sport since 1988, table tennis in-cludes several movements, shots (i.e., strokes), and positions. Consequently, many factors can affect the strokes' accuracy and strength. This paper aims twofold: to classify the type of shot and to enhance the performance of the classification by improving the recognition accuracy and reducing the computational time. To track the movement of the body parts and extract table tennis stroke information, sensors (both Accelerometers and Gyroscopes) were utilized. The extracted data are processed and passed to a P-Dollar classifier to recognize six different table tennis strokes. This work utilizes two classification approaches to evaluate the performance, both linear and hierarchical. The presented results demonstrate that the hierarchical classification yields a better accuracy of 88%, achieved in 4 seconds, while traditional linear classification achieved 83% within 6 seconds.},
   author = {Mustafa Ezzeldin and Amr S. Ghoneim and Laila Abdelhamid and Ayman Atia},
   doi = {10.1109/IMSA58542.2023.10217737},
   isbn = {9798350335569},
   journal = {1st International Conference of Intelligent Methods, Systems and Applications, IMSA 2023},
   keywords = {Human Activity Recognition HAR,P-Dollar,Table Tennis,accelerometer,gesture recognition,gyroscope},
   pages = {142-148},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {On Understanding Sports-HAR: Hierarchical, Mobile, Multi-Sensor based Classification of Table-Tennis Strokes},
   volume = {pp},
   year = {2023}
}
@article{Triwahyuni2024,
   abstract = {With everything being instant nowadays it results in someone without aware of experiencing a lack of movement. This can have a negative impact on health and can cause disease. To overcome this, currently there are many portable devices such as cell phones and smart watches that have functions as an activity monitor. However, it is still limited steps activity, even though human movement activities are not only manifested from steps. One of the problems is because the processing method still relies on processing simple digital signal processing (DSP). Other influencing factors is the processing component (central processing unit, CPU) that is used to have lightweight computing to pursue low device power consumption. This research develops a framework and prototype for custom human activity recognition (HAR) using inertial sensors. The microcontroller is used as a data processing unit so that it can recognize activities carried out. The method that will be used is a combination of digital signal processing and machine learning (ML), as well as equipped with an internet. As evaluation, hardware performance and activity recognition (3 basic table tennis movement) were tested. In the result, device prototype has maximum 245 mA draw current and up to 100% on accuracy of activity recognition. With IoT embed to the device its enable for further development and application usage.},
   author = {Nanik Triwahyuni and Eni Dwi Wardihani and Aminuddin Rizal},
   doi = {10.1109/EECSI63442.2024.10776152},
   isbn = {9798350355314},
   issn = {2407439X},
   journal = {International Conference on Electrical Engineering Computer Science and Informatics Eecsi},
   keywords = {digital signal processing (DSP),human activity recognition (HAR),inertial measurement unit (IMU) sensor,internet of things (IoT),wearable device},
   pages = {782-786},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Implementation of Artificial Intelligence Internet of Things (AIoT) Device for Activity Recognition},
   volume = {pp},
   year = {2024}
}
@article{Fujihara2024,
   abstract = {In this paper, we propose a classification method for table tennis strokes using player's 3D joint coordinates. In existing studies on stroke classification, classification is performed based on videos taken by a camera installed on a table tennis table or data obtained by attaching an inertial sensor to a player. However, in these existing methods, sensors and cameras interfere with the game, and it is difficult to adapt to the game videos. Therefore, in this paper, we classify strokes from videos that can be taken during games under more practical conditions. For the classification, we use the player's 3D joint coordinates as input to classify the game video. In our method, we use deep learning to learn two kinds of information, the recorded video and the player's joint coordinates obtained by 3D pose estimation and perform classification. As a result of the experiment, in the classification of the rally video dataset, the accuracy is improved by 4.2~15.5% in the validation data, which is the stroke of the learned player, and by 1.8~15.0% in the test data, which is the stroke of the unlearned player, compared with the existing method which input the videos and 2D joint coordinates.},
   author = {Yuta Fujihara and Xiangbo Kong and Ami Tanaka and Hiroki Nishikawa and Hiroyuki Tomiyama},
   doi = {10.1109/VCIP63160.2024.10849923},
   isbn = {9798331529543},
   journal = {2024 IEEE International Conference on Visual Communications and Image Processing, VCIP 2024},
   keywords = {3d keypoints,action recognition,table tennis},
   pages = {Article 2024},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Table Tennis Stroke Classification from Game Videos Using 3D Human Keypoints},
   volume = {2024},
   year = {2024}
}
